# ==============================================================================
# LOGIX AI - COLD-CHAIN DISPATCH CONSOLE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration (PostgreSQL Docker / RDS / Cloud SQL)
# SQL_DIALECT Options: 'postgresql' or 'mssql'
SQL_DIALECT=postgresql
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=5433
SQL_DATABASE=logix_db
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=LogixEnterprise2026!

# Read-Only Database Login for AI Agent
SQL_AGENT_USER=usr_logix_ro
SQL_AGENT_PASSWORD=LogixAgentPass2026!

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here

# Embeddings Model Configuration
# Options: 'LOCAL' (using HuggingFace BAAI/bge-m3) or 'OPENAI' (text-embedding-3-small)
Embeddings_model=LOCAL
Local_Embedding_Model=BAAI/bge-m3

# Agent Reasoner Brain Configuration
# Options: 'DEEPSEEK', 'OPENAI', 'OLLAMA'
Agent_llm=DEEPSEEK

# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional LangSmith Tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langchain_api_key_here
# LANGCHAIN_PROJECT=logix-ai
